[sub_resource type="Shader" id="Shader_507rp"]
code = "shader_type canvas_item;

uniform vec3 fire_color_1 : source_color = vec3(0.973, 0.941, 0.690);  // Bright white-yellow
uniform vec3 fire_color_2 : source_color = vec3(0.941, 0.878, 0.345);  // Mid yellow
uniform vec3 fire_color_3 : source_color = vec3(0.973, 0.565, 0.094);  // Orange
uniform vec3 fire_color_4 : source_color = vec3(0.784, 0.502, 0.031);  // Darker Orange
uniform float glow_strength = 2.0;
uniform float epsilon = 0.01;

bool matches_color(vec3 a, vec3 b, float eps) {
	return distance(a, b) < eps;
}

void fragment() {
	vec4 tex = texture(TEXTURE, UV);

	bool is_fire =
		matches_color(tex.rgb, fire_color_1, epsilon) ||
		matches_color(tex.rgb, fire_color_2, epsilon) ||
		matches_color(tex.rgb, fire_color_3, epsilon) ||
		matches_color(tex.rgb, fire_color_4, epsilon);

	vec3 result = tex.rgb;

	if (is_fire) {
		result *= (1.0 + glow_strength);
	}

	COLOR = vec4(result, tex.a);
}"

