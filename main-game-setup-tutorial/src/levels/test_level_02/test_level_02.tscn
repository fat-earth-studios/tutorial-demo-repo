[sub_resource type="GDScript" id="GDScript_604w1"]
script/source = "extends Camera2D

const LERP_WEIGHT : float = 4.0

@export var target : Node2D

func _physics_process(delta: float) -> void:
	if not target:
		return

	var target_global_pos = target.global_position

	var camera_pos_out : Vector2

	camera_pos_out.x = lerpf(self.global_position.x, target_global_pos.x, LERP_WEIGHT * delta)
	camera_pos_out.y = lerpf(self.global_position.y, target_global_pos.y, LERP_WEIGHT * delta)

	self.global_position = camera_pos_out
"

